<Window x:Class="Translator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translator Stage 2 · Batch B" Height="720" Width="800"
        MinHeight="600" MinWidth="680" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="13" Foreground="#52635A" FontWeight="SemiBold"
                       Text="STAGE 2 · REAL LOCAL TRANSLATION"/>
            <TextBlock Margin="0,8,0,0" FontSize="30" FontWeight="Bold"
                       Text="Screenshot, OCR and translate"/>
            <TextBlock Margin="0,8,0,0" Foreground="#52635A" TextWrapping="Wrap"
                       Text="The screenshot stays in local memory. Only the editable English text is sent to Chrome local translation."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,16" Orientation="Horizontal">
            <Button x:Name="CaptureButton" Width="180" Height="42"
                    Click="CaptureButton_Click" Content="Select screen region"/>
            <Button x:Name="TranslateButton" Margin="12,0,0,0" Width="180" Height="42"
                    Click="TranslateButton_Click" Content="Translate in Chrome"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Recognized English (editable)"/>
            <TextBox x:Name="RecognizedText" Grid.Row="1" Margin="0,8,0,14"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="16"/>
            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Chinese translation"/>
            <TextBox x:Name="TranslatedText" Grid.Row="3" Margin="0,8,0,14"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="17"
                     Background="#FAFCFA"/>
            <Border Grid.Row="4" Padding="12" Background="#F2F7F3" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Status"/>
                    <TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="Ready. Open Chrome with the Translator extension enabled before translating."/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,18,0,0" Foreground="#69786F" TextWrapping="Wrap"
                   Text="Batch B validates Desktop → Native Host → Chrome extension → local Translator API → Desktop."/>
    </Grid>
</Window>
