<Window x:Class="Translator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translator" Height="680" Width="760"
        MinHeight="560" MinWidth="640" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="Bold" Text="Translator"/>
            <TextBlock x:Name="ShortcutHint" Margin="0,6,0,0" Foreground="#52635A"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,16" Orientation="Horizontal">
            <Button x:Name="CaptureButton" Click="CaptureButton_Click"
                    Content="Select screen region"/>
            <Button x:Name="TranslateButton" Margin="10,0,0,0"
                    Click="TranslateButton_Click" Content="Translate Chinese"/>
            <Button x:Name="CopyButton" Margin="10,0,0,0"
                    Click="CopyButton_Click" Content="Copy Chinese"/>
            <Button x:Name="SettingsButton" Margin="10,0,0,0"
                    Click="SettingsButton_Click" Content="Shortcut settings"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Text="English (editable)"/>
            <TextBox x:Name="RecognizedText" Grid.Row="1" Margin="0,7,0,14"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="16"/>
            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Chinese"/>
            <TextBox x:Name="TranslatedText" Grid.Row="3" Margin="0,7,0,0"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="12" FontSize="17"
                     Background="#FAFCFA"/>
        </Grid>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12"
                Background="#F2F7F3" CornerRadius="8">
            <StackPanel>
                <DockPanel>
                    <TextBlock FontWeight="SemiBold" Text="Status"/>
                    <TextBlock x:Name="HotKeyText" DockPanel.Dock="Right"
                               Foreground="#52635A" TextAlignment="Right"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Starting local services..."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
